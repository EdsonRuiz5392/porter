# Copiar a .env y ajustar según el entorno.
# Ver docs/technical-guide/contratos-interfaces.md, sección 13.
JOBRUNNER_HOST=127.0.0.1
JOBRUNNER_PORT=9000
JOBRUNNER_MAX_CONCURRENCY=3
JOBRUNNER_MAX_QUEUE=20
JOBRUNNER_GRACE_SECONDS=5
JOBRUNNER_DATA_DIR=./data
JOBRUNNER_ALLOWED_NETWORKS=127.0.0.1
JOBRUNNER_MAX_MESSAGE_BYTES=65536
